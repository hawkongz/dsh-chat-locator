{
  "name": "dsh-chat-locator",
  "version": "1.4.3",
  "description": "Turn-rail settings for the DSH Web conversation locator: tick thickness, rail side, a curved length gradient anchored on the hovered tick, and a plain-text hover preview with adjustable line count, font size, and width.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "cordis-plugin",
    "web-ui",
    "conversation-navigation",
    "turn-navigator",
    "hover-preview"
  ],
  "license": "MIT",
  "author": "hawkongz",
  "homepage": "https://github.com/hawkongz/dsh-chat-locator#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hawkongz/dsh-chat-locator.git"
  },
  "bugs": {
    "url": "https://github.com/hawkongz/dsh-chat-locator/issues"
  },
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": {
      "default": "./index.js"
    },
    "./client": {
      "default": "./client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "docs",
    "zh-CN",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "test"
  ],
  "scripts": {
    "test": "node test/verify-client.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-store",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
